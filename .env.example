# ===== web =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== api =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 토큰 검증 방식에 맞춰 하나만 채운다
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# API 서버는 asyncpg 드라이버를 쓴다. 예: postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
DATABASE_URL=

# anthropic(기본, ANTHROPIC_API_KEY 필요) 또는 demo(키 없이 규칙 기반 데모 분석, 품질 낮음)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# 임베딩용(LLM은 Anthropic). 비어 있으면 임베딩 없이 동작한다
OPENAI_API_KEY=
LLM_MODEL_EXTRACT=claude-sonnet-5-5
LLM_MODEL_LIGHT=claude-haiku-5-5

# openai로 정했다. 비어 있으면 임베딩을 계산하지 않는다. OPENAI_API_KEY가 필요하다
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

SEARCH_API_PROVIDER=
SEARCH_API_KEY=
CRAWLER_USER_AGENT=

RESEND_API_KEY=
EMAIL_FROM=

# 성장 나무 단계 기준(점수 = 승인 항목 x2 + 일기를 쓴 날). 스펙 레이더 기본 목표: dev_job | biz_job | public_job | grad_school
GROWTH_STAGE_THRESHOLDS=1,10,30,60
SPEC_DEFAULT_PRESET=dev_job

CRON_SECRET=
ALLOWED_ORIGINS=http://localhost:3000
# 파일 저장: auto면 SUPABASE_SERVICE_ROLE_KEY가 있을 때 Supabase Storage, 없으면 로컬 폴더를 쓴다
STORAGE_BACKEND=auto
STORAGE_LOCAL_DIR=.storage
# 로컬 저장소일 때 파일 링크 앞부분(API 서버 주소)
API_PUBLIC_URL=http://localhost:8000
# 문서 PDF용 Chromium 경로. 비우면 `uv run playwright install chromium`으로 받은 브라우저를 쓴다
PDF_CHROMIUM_EXECUTABLE=
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_MB=10
DAILY_LIMIT_EXTRACT=50
DAILY_LIMIT_IMPORT=10
DAILY_LIMIT_DOCUMENT=30
DAILY_LIMIT_URL_ADD=20
