{% macro period(p, ongoing, en=false) -%}
{%- set s = p[0][:7] | replace('-', '.') if p[0] else '' -%}
{%- set e = (('Present' if en else '현재') if ongoing else (p[1][:7] | replace('-', '.') if p[1] else '')) -%}
{%- if s and e and s != e %}{{ s }} – {{ e }}{% elif s %}{{ s }}{% else %}{{ e }}{% endif -%}
{%- endmacro %}

{% macro entry(item, en=false) -%}
<div class="entry">
  {%- set org = item.organization if item.organization != item.title else None %}
  {%- set sub = [org, item.role, (item.details.major ~ ' ' ~ (item.details.degree or '')) if item.details.major else None] | select | list %}
  <div><span class="title">{{ item.title }}</span>{% if sub %}<span class="org"> · {{ sub | join(' · ') }}</span>{% endif %}</div>
  <div class="date">{{ period(item.period, item.is_ongoing, en) }}</div>
  {% if item.lines %}<ul>{% for l in item.lines %}<li>{{ l }}</li>{% endfor %}</ul>{% endif %}
</div>
{%- endmacro %}

{% macro header(c, x) -%}
<header>
  <h1>{{ c.basics.name or '이름' }}</h1>
  {% if c.basics.label %}<div class="muted">{{ c.basics.label }}</div>{% endif %}
  <div class="contact">
    {% if c.basics.email %}<span>{{ c.basics.email }}</span>{% endif %}
    {% for p in c.basics.profiles %}<span><a href="{{ p.url }}">{{ p.network }}</a></span>{% endfor %}
  </div>
</header>
{%- endmacro %}
