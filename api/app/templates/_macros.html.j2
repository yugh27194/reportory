{# 편집 표식: data-edit(line·title·summary)과 data-item. 미리보기에서만 고칠 수 있게 쓰인다. #}
{% macro period(p, ongoing, en=false, sep=' – ') -%}
{%- set s = p[0][:7] | replace('-', '.') if p[0] else '' -%}
{%- set e = (('Present' if en else '현재') if ongoing else (p[1][:7] | replace('-', '.') if p[1] else '')) -%}
{%- if s and e and s != e %}{{ s }}{{ sep }}{{ e }}{% elif s %}{{ s }}{% else %}{{ e }}{% endif -%}
{%- endmacro %}

{% macro en_month(d) -%}
{{ ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][(d[5:7] | int) - 1] }} {{ d[:4] }}
{%- endmacro %}

{% macro en_period(p, ongoing) -%}
{%- set s = en_month(p[0]) if p[0] else '' -%}
{%- set e = 'Present' if ongoing else (en_month(p[1]) if p[1] else '') -%}
{%- if s and e and s != e %}{{ s }} – {{ e }}{% elif s %}{{ s }}{% else %}{{ e }}{% endif -%}
{%- endmacro %}

{% macro title(id, item) -%}<span data-edit="title" data-item="{{ id }}">{{ item.title }}</span>{%- endmacro %}

{% macro lines(id, item, cls='lines') -%}
<ul class="{{ cls }}" data-lines="{{ id }}">{% for l in item.lines %}<li data-edit="line" data-item="{{ id }}">{{ l }}</li>{% endfor %}</ul>
{%- endmacro %}

{% macro skills_all(x) -%}
{%- set ns = namespace(out=[]) -%}
{%- for id, it in x['items'].items() -%}{%- for s in it.skills -%}{%- if s not in ns.out -%}{%- set ns.out = ns.out + [s] -%}{%- endif -%}{%- endfor -%}{%- endfor -%}
{{ ns.out | join(', ') }}
{%- endmacro %}
