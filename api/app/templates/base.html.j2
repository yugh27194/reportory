<!doctype html>
<html lang="{{ x.language }}">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
{{ fonts_css | safe }}
@page { size: A4; margin: {% block page_margin %}15mm 16mm 16mm 16mm{% endblock %}; }
:root {
  --ink: #0E1B2A; --deep: #224B46; --accent: #4FD1C5; --mint: #D9FFF8; --cream: #FFF7E6;
  --muted: #4f5b66; --line: #cfd6dc; --rule: #0E1B2A;
  --sans: "Pretendard", "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans KR", sans-serif;
  --serif: "Source Serif 4", "Georgia", "Times New Roman", "Pretendard", "Malgun Gothic", serif;
}
* { box-sizing: border-box; }
html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body { margin: 0; color: var(--ink); background: #fff; font-family: var(--sans); font-size: 10pt; line-height: 1.45; word-break: keep-all; }
.doc { max-width: 178mm; margin: 0 auto; }
a { color: inherit; text-decoration: none; }
ul.lines { margin: 2pt 0 0; padding-left: 12pt; }
ul.lines:empty { display: none; }
ul.lines li { margin: 0.5pt 0; }
table { width: 100%; border-collapse: collapse; }
.muted { color: var(--muted); }
/* 미리보기 화면 여백(PDF에는 @page 여백이 쓰인다) */
@media screen { body { padding: 14mm 0; } }
{% block style %}{% endblock %}
</style>
</head>
<body><div class="doc">{% block body %}{% endblock %}</div></body>
</html>
